{"nodes": [{"id": "implementation_plan_phase0_baseline", "label": "Phase 0 - Baseline Measurement", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 0", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No code changes; numbers are the yardstick for every later phase. Spec 05 interference is expected to fail - that is the bug, not the test."}, {"id": "implementation_plan_phase1_pool_tuning", "label": "Phase 1 - Npgsql Pool & Prepare Tuning", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pool settings applied in code via NpgsqlConnectionStringBuilder so they hold regardless of env-var contents; Multiplexing=true deliberately deferred to Phase 7 because it changes failure semantics and deserves its own A/B; Postgres max_connections must exceed 2x MaxPoolSize."}, {"id": "implementation_plan_phase2_stats_cache", "label": "Phase 2 - Stats Cache + Parallelize", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "30s TTL plus single-flight guard so a stampede of cold-cache callers cannot launch N aggregate scans; both databases queried concurrently with Task.WhenAll; worst rollback case is stale-by-30s stats which the UI tolerates."}, {"id": "implementation_plan_phase3_cancellation", "label": "Phase 3 - Cancellation Propagation", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal APIs bind CancellationToken from HttpContext.RequestAborted; Npgsql translates token cancellation into a Postgres CANCEL so abandoned queries stop consuming DB CPU."}, {"id": "implementation_plan_phase4_nginx_keepalive", "label": "Phase 4 - nginx Upstream Keepalive", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "upstream block with keepalive 256 + proxy_http_version 1.1 + empty Connection header; verified by through-proxy RPS within a few percent of direct and flat TIME-WAIT count."}, {"id": "implementation_plan_phase5_verify_cache", "label": "Phase 5 - Verify-Result Cache (10K enabler)", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NAD reference data is read-only between bulk reloads so identical queries always produce identical results; key is the normalized lowercased whitespace-collapsed query; negative caching with shorter TTL for empty results; invalidation is implicit via app restart on reload; hit/miss counters exposed on /api/health. The one phase that changes the capacity class of the system."}, {"id": "implementation_plan_phase6_json_sourcegen", "label": "Phase 6 - JSON Source-Gen + Micro-Optimizations", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source-generated JsonSerializerContext, typed NpgsqlParameter, GetFloat instead of boxing Convert.ToDouble, dev-only CORS; verify response bodies byte-identical because field casing can silently change when switching resolvers."}, {"id": "implementation_plan_phase7_scaleout", "label": "Phase 7 - Scale-Out (conditional)", "file_type": "concept", "source_file": "implementation_plan.md", "source_location": "Phase 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision gate: proceed only if miss volume x per-miss DB cost exceeds ~60% of one Postgres box after the Phase 5 cache soaks; covers Multiplexing A/B, horizontal API instances (stateless + per-instance cache, no coordination), and read replicas with writes pinned to primary."}], "edges": [{"source": "implementation_plan_phase1_pool_tuning", "target": "performance_tune_finding1_npgsql_pool", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 1 ('Finding 1')", "weight": 1.0}, {"source": "implementation_plan_phase2_stats_cache", "target": "performance_tune_finding4_stats_dos", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 2 ('Finding 4')", "weight": 1.0}, {"source": "implementation_plan_phase3_cancellation", "target": "performance_tune_finding3_cancellation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 3 ('Finding 3')", "weight": 1.0}, {"source": "implementation_plan_phase4_nginx_keepalive", "target": "performance_tune_finding5_nginx_keepalive", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 4 ('Finding 5')", "weight": 1.0}, {"source": "implementation_plan_phase5_verify_cache", "target": "performance_tune_verify_result_cache", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 5 ('Capacity-math fix')", "weight": 1.0}, {"source": "implementation_plan_phase6_json_sourcegen", "target": "performance_tune_finding6_micro_wins", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "implementation_plan.md", "source_location": "Phase 6 ('Finding 6')", "weight": 1.0}, {"source": "implementation_plan_phase7_scaleout", "target": "performance_tune_read_