{"nodes": [{"id": "melissa_address_verification_csharp_guide_global_address_api", "label": "Melissa Global Address Cloud API (doGlobalAddress)", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 3.2", "source_url": "https://address.melissadata.net/v3/WEB/GlobalAddress/doGlobalAddress", "captured_at": null, "author": null, "contributor": null, "rationale": "One request carries up to ~100 records, the foundation of the batching strategy: one HTTP round-trip verifies an entire batch and many batches run concurrently."}, {"id": "melissa_address_verification_csharp_guide_melissaconfig", "label": "MelissaConfig", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All tunables come from environment variables so the same image behaves correctly in every environment; fails fast at startup if the license key is absent."}, {"id": "melissa_address_verification_csharp_guide_melissaaddressclient", "label": "MelissaAddressClient", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translates HTTP status into transient (429/5xx) vs terminal (other 4xx) exception types so the resilience pipeline retries only what is safe to retry."}, {"id": "melissa_address_verification_csharp_guide_batchaddressverifier", "label": "BatchAddressVerifier", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bounded SemaphoreSlim caps in-flight requests to the Melissa contract concurrency limit (back-pressure); failed batches are replaced with SE01 error sentinels so one bad batch never aborts the run; results re-aligned by RecordID for deterministic order."}, {"id": "melissa_address_verification_csharp_guide_resiliencepolicies", "label": "ResiliencePolicies (Polly v8 Pipeline)", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ordered retry -> circuit breaker -> rate limiter -> per-attempt timeout; contract limits, not raw machine capacity, are the binding throughput constraint, which is why the app rate-limits itself."}, {"id": "melissa_address_verification_csharp_guide_resultinterpreter", "label": "ResultInterpreter", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downstream systems should branch on a single verdict enum, not raw codes scattered through the pipeline; parses the comma-delimited Results string once."}, {"id": "melissa_address_verification_csharp_guide_verificationworker", "label": "VerificationWorker", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 5.10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch-mode hosted service: runs the batch then calls StopApplication so the container exits cleanly when the run completes."}, {"id": "melissa_address_verification_csharp_guide_result_codes", "label": "Melissa Result Codes (AV/AC/AE/GS families)", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Sections 3.5, 9.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AV2x = full verification (final digit = granularity), AV1x = partial only, AC = corrections, AE = errors, GS/GE = geocode status; the Results string is the authoritative signal for downstream logic."}, {"id": "melissa_address_verification_csharp_guide_terraform_infra", "label": "Terraform Azure Container Apps Infrastructure", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two-pass apply because the container app references an image in a registry created by the same configuration; .NET/Docker layers are cloud-agnostic so only the Terraform layer changes per platform."}, {"id": "melissa_address_verification_csharp_guide_keda_scaling", "label": "KEDA Queue-Depth Scaling", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Sections 4.1, 8.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two independent scaling axes: vertical (async concurrency inside a replica) and horizontal (KEDA replicas on queue depth, scale-to-zero); the product of per-replica concurrency and replica count must still respect the Melissa contract."}, {"id": "melissa_address_verification_csharp_guide_key_vault_secrets", "label": "Key Vault License-Key Secret Management", "file_type": "concept", "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Sections 4.5, 7.5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "License key never baked into source or image; injected via managed identity from Key Vault; body-based auth keeps the key out of URLs and logs."}], "edges": [{"source": "melissa_address_verification_csharp_guide_melissaaddressclient", "target": "melissa_address_verification_csharp_guide_global_address_api", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Melissa_Address_Verification_CSharp_Guide.md", "source_location": "Sec